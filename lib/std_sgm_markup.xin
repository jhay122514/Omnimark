;*******************************************************************************
; S T D _ S G M _ M A R K U P . X I N
;-------------------------------------------------------------------------------
; THIS PROGRAM REQUIRES OMNIMARK V6.0e5 OR GREATER TO OPERATE.
;-------------------------------------------------------------------------------
; M O D I F I C A T I O N   H I S T O R Y
; ---------------------------------------
; 04/14/2023 Jose.Sico (TCSG) Initial Build
;*******************************************************************************
INCLUDE-GUARD 'std_sgm_markup.xin'

GLOBAL SWITCH indent_sgm INITIAL {FALSE}
GLOBAL SWITCH entity_sgm_rule INITIAL {TRUE}
GLOBAL SWITCH pi_sgm_rule INITIAL {TRUE}
GLOBAL SWITCH comment_sgm_rule INITIAL {TRUE}

; ==============================================================================
; Rule:      TRANSLATE ENTITY
;
; Purpose:   Catches named entities and outputs them in their original
;            literal format (&name;) to prevent expansion during processing.
; ==============================================================================
TRANSLATE ENTITY NAMED ANY+=entityname WHEN entity_sgm_rule
  OUTPUT '&%x(entityname);'


; ==============================================================================
; Rule:      PROCESSING-INSTRUCTION
;
; Purpose:   Captures SGML processing instructions (PIs) and re-outputs them
;            using standard PI delimiters (<? ... >).
; ==============================================================================
PROCESSING-INSTRUCTION VALUED ANY*=>pitext WHEN pi_sgm_rule
  OUTPUT '<?%x(pitext)>'


; ==============================================================================
; Rule:      MARKUP-COMMENT
;
; Purpose:   Captures comment and re-outputs them using standard comment
;            (<!-- ... -->).
; ==============================================================================
MARKUP-COMMENT WHEN comment_sgm_rule
  OUTPUT '%n' WHEN CONTENT OF PARENT IS ELEMENT
  OUTPUT '<!-- %c -->'


; ==============================================================================
; Macro:     OutputStartTag
;
; Purpose:   Constructs an SGML start tag with all specified attributes.
;            Prepends a newline if the parent has an element-only content model.
; ==============================================================================
MACRO OutputStartTag IS
  DO
    DO WHEN NUMBER OF CURRENT ELEMENTS > 1
      OUTPUT '%n' WHEN CONTENT OF PARENT IS ELEMENT
      OUTPUT ' ' ||* ((NUMBER OF CURRENT ELEMENTS - 1) * 2) WHEN indent_sgm
    DONE

    OUTPUT '<%q'

    REPEAT OVER SPECIFIED ATTRIBUTES AS attr
      OUTPUT ' ' || KEY OF ATTRIBUTE attr || '="%v(attr)"'
    AGAIN

    OUTPUT '>'
  DONE
MACRO-END


; ==============================================================================
; Macro:     OutputEndTag
;
; Purpose:   Outputs an SGML end tag for the current element, provided the
;            element is not declared as EMPTY or CONREF.
; ==============================================================================
MACRO OutputEndTag IS
  DO WHEN CONTENT ISNT EMPTY
    DO WHEN CONTENT ISNT MIXED
      OUTPUT '%n'
      OUTPUT ' ' REPEATED ((NUMBER OF CURRENT ELEMENTS - 1) * 2) WHEN indent_sgm
    DONE
    OUTPUT '</%q>'
  DONE
MACRO-END


; ==============================================================================
; Macro:     OutputThisElement
;
; Purpose:   A wrapper to output the current element in its entirety,
;            including the start tag, internal content (%c), and end tag.
; ==============================================================================
MACRO OutputThisElement IS
  DO
    OutputStartTag
    OUTPUT '%c'
    OutputEndTag
  DONE
MACRO-END


; ==============================================================================
; Macro:     OutputThisElementArg
;
; Purpose:   Outputs the current element's tags but replaces the actual
;            content with a custom provided string.
;
; Arguments: ARG this_content - The custom content to place between the tags.
; ==============================================================================
MACRO OutputThisElementArg (ARG this_content) IS
  OutputStartTag
  OUTPUT this_content
  OutputEndTag
MACRO-END
